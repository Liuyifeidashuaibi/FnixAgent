# =========================================================================
# Fnix Harness — 环境变量模板
# 复制：cp .env.example .env
# Desktop 用户的 LLM Key 在应用内 Settings 填写（BYOK），不必写入下方 Key
# =========================================================================

# --- 部署形态 ---
# standalone = 本机零 Docker（开源默认，推荐）
FNIXAGENT_PROFILE=standalone

# --- 产品策略：仅 BYOK（Desktop 用户必须自带 API Key）---
FNIX_API_ONLY=1

# --- fnix-local sidecar ---
FNIX_LOCAL_URL=http://127.0.0.1:8710

# --- 可选：headless / CLI 调试用的 LLM Key（Desktop 用户可留空）---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# --- JWT（本地 dev 可用默认；公开 fork/部署务必修改）---
JWT_SECRET_KEY=change-me-before-public-deploy
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- 服务 ---
SERVICE_NAME=fnixagent
SERVICE_ENV=development
SERVICE_DEBUG=true
LOG_LEVEL=INFO

# --- 可选：Docker 栈（standalone 不需要）---
# DATABASE_URL=postgresql+psycopg2://fnixagent:fnixagent-dev@localhost:5432/fnixagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379

# --- 所有者通道（本地测试；生产请修改）---
FNIX_OWNER_USERNAME=admin
FNIX_OWNER_TOKEN=change-me-owner-token
FNIX_OWNER_EMAIL=admin@local.fnix

# --- 运行模式 ---
FNIXAGENT_MODE=both

# --- Beta live quality gate（需先启动 agentd）---
# GATE_FCS_LIVE=1
# GATE_FCS_MIN_HARD_PASS=70
# GATE_WORK_GOLDEN_LIMIT=0
# GATE_WORK_GOLDEN_MIN_PASS=8
# FNIX_API_BASE=http://127.0.0.1:8003
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus
