# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info

# 虚拟环境
.venv/
venv/
env/

# Node / pnpm
node_modules/
pnpm-debug.log*
npm-debug.log*
.corepack/

# 构建产物
apps/*/dist/
apps/*/build/
packages/*/dist/
packages/*/build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 环境变量
.env
.env.local
.env.*.local
.env.prod
.env.production

# 备份配置(含敏感凭据)
deploy/scripts/backup.env

# 数据目录(运行时生成)
data/uploads/*
!data/uploads/.gitkeep

# 测试报告
pytest_report.xml
coverage.xml

# Helm Chart 依赖(运行 helm dependency update 拉取)
deploy/helm/*/charts/*.tgz
deploy/helm/*/Chart.lock

# 敏感文件
.secret_meta.json
assets/keys/default.private.pem

# 临时文件
*.tmp
*.tsbuildinfo

# Vite 缓存(monorepo 子应用)
apps/*/node_modules/

# 调试文件
_dbg_*.png

# 操作系统
.DS_Store
Thumbs.db

# 日志文件
*.log

# 私钥文件通配
*.private.pem
*.private.key

# 运行时数据(保留种子数据)
data/cache/
data/db/
data/logs/

# FNIX-SE local index / durable / storage
.fnix/
**/.fnix/

# AgentOS (fnix-se) canonical repo is FnixAi — keep local copy optional, never publish here
/fnix-se/

# Large third-party reference trees (study only; not FnixAgent product source)
/_references/grok-build/
/_references/ui/

# AgentOS CI lives in FnixAi, not this repo
.github/workflows/fnix-se-core.yml

# Local AgentOS scaffold helpers (history)
scripts/restore_fnix_se_from_trae_history.py
scripts/scaffold_fnix_se_partial.py

