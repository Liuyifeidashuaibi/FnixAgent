# FnixAgent 生产环境变量模板
#
# 用法:
#   cp .env.prod.example .env.prod
#   make gen-secrets     # 自动填充随机密码
#   vi .env.prod         # 手动填写 LLM API 密钥
#
# 启动:
#   docker compose -f deploy/docker/docker-compose.prod.yml --env-file .env.prod up -d --build
#
# 安全提示:
#   - 所有标 *** 必填 *** 的项必须填写,否则容器无法启动
#   - 请使用强随机串(>= 24 字节),可用 `openssl rand -hex 24` 生成
#   - 切勿将 .env.prod 提交到 git(已在 .gitignore 中忽略)

# =============================================================================
# 数据库与缓存(*** 必填 ***)
# =============================================================================

# PostgreSQL 密码
POSTGRES_PASSWORD=change_me_to_random_hex_24

# Redis 密码
REDIS_PASSWORD=change_me_to_random_hex_24

# MinIO 访问键(8-20 字符,仅字母数字)
MINIO_ACCESS_KEY=fnixagent

# MinIO 秘密键(>= 16 字节)
MINIO_SECRET_KEY=change_me_to_random_hex_16

# Elasticsearch elastic 用户密码
ES_PASSWORD=change_me_to_random_hex_16

# =============================================================================
# 应用配置(*** 必填 ***)
# =============================================================================

# JWT 签名密钥(>= 32 字节,HS256 算法)
JWT_SECRET_KEY=change_me_to_random_hex_32

# 运行模式:legacy(传统模式) / evolve(自进化模式)
FNIXAGENT_MODE=evolve

# 环境标识
SERVICE_ENV=production

# =============================================================================
# LLM API 密钥(至少配置一个,否则 AI 对话不可用)
# =============================================================================

# 智谱 GLM
GLM_API_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 阿里通义千问
QWEN_API_KEY=

# =============================================================================
# 可选:Embedding 模型 API 密钥(若与 LLM 不同)
# =============================================================================

EMBEDDING_API_KEY=

# =============================================================================
# 可选:监控与日志
# =============================================================================

LOG_LEVEL=INFO

# Prometheus 监控(需额外部署 grafana/prometheus)
PROMETHEUS_ENABLED=false

# Jaeger 链路追踪(需额外部署 jaeger)
JAEGER_ENABLED=false

# =============================================================================
# 可选:安全模块开关
# =============================================================================

# 敏感词过滤
SENSITIVE_WORDS_ENABLED=true

# SQL/PII 注入防护
INJECTION_PROTECTION_ENABLED=true

# 内容审核
MODERATION_ENABLED=true
