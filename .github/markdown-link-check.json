{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    },
    {
      "pattern": "^http://127\\.0\\.0\\.1"
    },
    {
      "pattern": "^http://0\\.0\\.0\\.0"
    },
    {
      "pattern": "^https://github\\.com/.*/(issues|pulls|actions|commit|blob|tree)/[a-f0-9]{6,}$"
    }
  ],
  "httpHeaders": [
