{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fnix",
  "version": "1.0.0",
  "identifier": "com.fnix.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5175",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Fnix",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' http://127.0.0.1:* http://localhost:* https://127.0.0.1:* https://localhost:* ws://127.0.0.1:* ws://localhost:* https://generativelanguage.googleapis.com https://api.groq.com https://api.openai.com https://openrouter.ai https://api.openrouter.ai https://api.z.ai https://api.anthropic.com https://api.deepseek.com https://api.duckduckgo.com https://*.aliyuncs.com https://open.bigmodel.cn; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/fnixagent-py/": "fnixagent-py/",
      "resources/fnix-local/": "fnix-local/",
      "resources/agentd/": "agentd/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Liuyifeidashuaibi/FnixAgent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5QjM0M0JFRDE5RjM2NzMKUldSek5wL1J2a096ZVhZNnRwbEU2ZEFTTWRJcUVKcjY2d1B0Qi9jM2RUZjJQTE8yaTZXMUY0ei8K"
    }
  }
}
