{
  "name": "@fnixagent/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "fnixagent 桌面客户端(Electron + React)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "build:all": "electron-vite build && electron-builder --win --mac --linux --config electron-builder.yml",
    "publish": "electron-vite build && electron-builder --publish always --config electron-builder.yml"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@fnixagent/sdk": "workspace:*",
    "@fnixagent/ui": "workspace:*",
    "electron-updater": "^6.2.1",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
