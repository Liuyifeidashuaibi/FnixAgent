# FnixAgent 备份/恢复环境配置 — Phase 2.9
#
# 用法:
#   1. 复制此文件为 backup.env
#   2. 填写真实值(切勿提交到 Git)
#   3. backup.sh / restore.sh 会自动加载同目录下的 backup.env
#
# 安全提示:
#   - 此文件包含敏感信息,已在 .gitignore 中排除
#   - 生产环境建议通过 Secrets Manager / Vault 注入这些环境变量

# ============================================================================
# 备份策略
# ============================================================================
BACKUP_ROOT=/data/backups                  # 备份根目录
RETENTION_DAYS_LOCAL=7                     # 本地保留天数
RETENTION_DAYS_REMOTE=90                   # 异地保留天数(由对象存储生命周期管理)
COMPRESS_LEVEL=6                           # gzip 压缩级别(1-9)
PARALLEL_JOBS=4                            # pg_restore 并发数

# ============================================================================
# PostgreSQL 连接
# ============================================================================
PG_HOST=postgres                           # 主机名(K8s Service / docker service)
PG_PORT=5432
PG_USER=fnixagent
PG_DB=fnixagent
PG_PASSWORD=CHANGE_ME                      # 数据库密码
PG_WAL_ARCHIVE_DIR=                        # WAL 归档目录(若开启 archive_mode)

# ============================================================================
# Redis 连接
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME                   # Redis 鉴权 Token

# ============================================================================
# MinIO / Milvus
# ============================================================================
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MILVUS_BUCKET=milvus                       # Milvus 数据 bucket
APP_BUCKET=fnixagent                     # 应用文件 bucket

# ============================================================================
# 异地对象存储(留空则跳过异地同步)
# ============================================================================
# AWS S3 示例:
# REMOTE_ENDPOINT=https://s3.ap-east-1.amazonaws.com
# 阿里云 OSS 示例:
# REMOTE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
REMOTE_ENDPOINT=
REMOTE_ACCESS_KEY=
REMOTE_SECRET_KEY=
REMOTE_BUCKET=fnixagent-backup

# ============================================================================
# 恢复专用参数(restore.sh 使用)
# ============================================================================
PG_DATA_DIR=/var/lib/postgresql/data       # PostgreSQL 数据目录(PITR 时需要)
REDIS_DATA_DIR=/data                       # Redis 数据目录(RDB 替换时需要)
