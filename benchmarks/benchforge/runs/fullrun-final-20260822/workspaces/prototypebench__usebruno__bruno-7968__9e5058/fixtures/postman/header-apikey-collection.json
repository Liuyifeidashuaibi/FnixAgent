{
  "info": {
    "_postman_id": "12345",
    "name": "Header API Key Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Key Header Request",
      "request": {
        "method": "GET",
        "url": "https://api.example.com/data",
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "X-API-Key",
              "value": "{{apiKey}}",
              "in": "header"
            }
          ]
        }
      }
    }
  ]
}