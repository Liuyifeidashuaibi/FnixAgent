{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fnix.local/benchmarks/code/task.schema.json",
  "title": "FnixCodeBenchmarkTask",
  "type": "object",
  "required": ["id", "prompt", "capability", "difficulty", "language", "checks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "title": { "type": "string" },
    "prompt": { "type": "string", "minLength": 8 },
    "capability": {
      "type": "array",
      "items": {
        "enum": [
          "write",
          "edit",
          "bugfix",
          "test_gen",
          "refactor",
          "search",
          "multi_file",
          "api",
          "cli",
          "heal"
        ]
      },
      "minItems": 1
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "language": { "type": "string", "enum": ["python", "typescript", "rust", "mixed"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "timeout_s": { "type": "integer", "minimum": 10, "maximum": 3600, "default": 180 },
    "setup": {
      "type": "object",
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["function"],
        "properties": {
          "function": { "type": "string" },
          "args": { "type": "object" },
          "required": { "type": "boolean", "default": true },
          "weight": { "type": "number", "minimum": 0, "default": 1 }
        }
      }
    }
  }
}
