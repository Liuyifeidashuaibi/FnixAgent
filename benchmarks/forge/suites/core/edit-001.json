      "args": {
        "path": "config.ini",
        "text": "mode = debug"
      }
    },
    {
      "function": "file_contains",
      "args": {
        "path": "config.ini",
        "text": "workers = 4"
      },
      "desc": "其余行未被误改"
    },
    {
      "function": "scope_respected",
      "args": {}
    }
  ]
