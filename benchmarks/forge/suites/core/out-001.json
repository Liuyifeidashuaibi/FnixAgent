        "pointer": "status",
        "equals": "ok"
      }
    },
    {
      "function": "file_json_field",
      "args": {
        "path": "result.json",
        "pointer": "value",
        "equals": 14
      },
      "weight": 2.0,
      "desc": "value 必须是数字 14"
    }
  ]
}